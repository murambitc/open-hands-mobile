{
  "expo": {
    "name": "openHands",
    "slug": "openHands",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openhands",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "bw.co.openhands.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Open Hands uses your location to help connect you with nearby support and emergency services.",
        "NSPhotoLibraryUsageDescription": "Open Hands needs access to your photo library so you can select and upload images.",
        "NSCameraUsageDescription": "Open Hands needs camera access so you can take photos within the app.",
        "NSMicrophoneUsageDescription": "Open Hands needs microphone access for audio features and voice commands.",
        "NSSpeechRecognitionUsageDescription": "Open Hands uses speech recognition so you can speak messages and voice commands.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "bw.co.openhands.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2F5DAA",
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#0b1220"
          }
        }
      ],
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      "expo-secure-store",
      "expo-location",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Open Hands to access your photos."
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "root": "./src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f2f13fd7-c268-4e19-9d4b-e3ea12c20165"
      }
    },
    "owner": "tawandaclementmurambi"
  }
}